{

time-packet-rate            = 60   , // Частота отправки пакетов с временем
// Чанки тикают "градиентно" - в малом радиусе с нормальной скоростью, в большом - в 2 раза реже
chunk-tick-radius-m         = 64   , // Малый радиус тика
chunk-tick-radius-s         = 80   , // Большой радиус тика
// Настройка алгоритма балансировка тика блоков в чанках, меньше число - меньше артефактов
// Больше число - выше скорость и больше артефактов, не рекомендую больше 20
balance-block-tick          = 3    , // Балансировка блоков в нормальном режиме
balance-block-critical      = 7    , // Балансировка блоков во время перегрузки
mean-balance-block          = 35   , // Предельное время тика, после которого включается бал. блоков
mean-balance-mob            = 35   , // Предельное время тика, после которого включается бал. ИИ мобов 
goal-tick-rate              = 4    , // Базовая частота обновления пути
recheck-spawner-rate        = 80   , // Длительность хранения кеша S1 у мирового спавнера
recheck-chunks-spawner-rate = 7    , // Длительность хранения кеша S2 у мирового спавнера
max-world-spawner-range     = 6    , // Максимальный радиус работы мирового спавнера (в чанках)
check-to-unload-rate        = 600  , // Частота, с которой будет происходить полная перепроверка чанков для выгрузки
save-world-rate             = 12000, // Частота полного сохранения мира
navigation-cache-clean-rate = 300  , // Частота очистки навигационного кеша
std-update-navigation-rate  = 20   , // todo Устарело
max-update-navigation-rate  = 40   , // todo Устарело
navigate-reset-rate         = 1500 , // Частота высвобождения памяти навигационного кеша
network-compression-lvl     = 4    , // Уровень сжатия у сети
max-entity-collisions       = 3    , // Максимальное количество коллизий с сущностями
max-entity-collisions-move  = 1    , // Максимальное количество коллизий с сущностями при движении
min-changed-blocks-buf      = 24   , // Размер буфера отправки измененных блоков
reset-low-level-mobs        = 200  , // Время, после которого частота и точность обновления моба может быть изменена

// Собственные мини-утилиты, по умолчанию ванильные значения
max-sponge-power            = 64   , // Макс. количество блоков, к-е может впитать губка
max-sponge-radius           = 6    , // Макс. радис, в котором будет губка впитывать воду
max-piston-power            = 12   , // Макс. кол-во блоков, к-е может толкать поршень
beacon-tick-rate            = 85   , // Частота обновлений маяка
enable-item-binds           = true , // Активировать модуль бинда функций на использование предмета

immediate-update-limit      = 24   , // Макс. количество блоков, к-е можно обновить мгновенно рекурсией
slow-swim-ai                = true , // todo 
slow-temp-check             = true , // todo 
slow-wander                 = true , // todo 
disable-session-lock        = true , // Удалить проверку файла session.lock
ignore-errors               = true , // Продолжать работу сервера, даже при критических ошибках
remove-error-entities       = true , // Удалять сущностей, которые стали причиной ошибки
overworld-async-population  = true , // Включить асинхроннкю популяцию
skip-check-network          = true , // Отключить проверки сетевого модуля при старте
print-case-stop             = true , // Отобразить причину остановки сервера
endable-def-join-msg        = true , // Включить ванильные сообщения о входе и выходе
// Настройки встроенного Firewall
max-connections-per         = 15   ,
max-connections-time        = 1000 ,
max-connections-warn        = 10   ,

init-palette-linear-bits    = 4    , // Изменение паллеты НЕ РЕДАКТИРОВАТЬ БЕЗ МОДА
cache-chunk-data            = 24   , // Размер пула пакетов чанков
pcm-max-load-per-tick       = 50   , // Макс. кол-во чанков, которые могут быть загружены за 1 тик
pcm-max-send-per-tick       = 128  , // Макс. кол-во чанков, которые могут быть отправлены за 1 тик
use-async-tracker-def       = false, // Использовать ли асинхронный трекер сущностей всегда
unimportant-packet-queue    = true , // Использовать неважную очередь, работает быстрее, но может нарушить порядок отправки
enable-asm-trimmer          = true , // Удалить мусор
thread-pool-size            = 12   , // Размер пула потоков, если не указано - выбирается автоматически
async-explosion-threshold   = 32   , // Предельное количество сущностей, превышая которое взрыв делается асинхронно
global-light-pool           = true , // Использовать глобальный пул памяти света

//Переменные для @VarOnly аннотаций
vars = {
	fast-water-check    = true,
	fix-shulcer-nbt-view = true
}

}