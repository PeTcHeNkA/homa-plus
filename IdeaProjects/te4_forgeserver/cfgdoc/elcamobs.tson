{
	// Радиусы "агрессивной" оптимизации сущностей
	// Коэффиценты указаны приблизительно
	// 0 - (0-A) не оптимизировать        (1.0х        )
	// 1 - (A-B) минимальные оптимизации  (1.4х - 1.7х ) near
	// 2 - (B-C) средние оптимизации      (1.7х - 2.8х ) mid
	// 3 - (C+ ) значительные оптимизации (2.8х - 6.5х+) lowest
	// Если С (3) параметр не указан, он вычисляется авоматически по фломуле low+(low-near)
	// Возможна подробная запись типа 'entity = {low = 10, mid = 20, lowest = 30}'
	global     = [24, 44],
	water      = [18, 34],
	monsters   = [22, 38],
	animals    = [18, 38],
	ambient    = [14, 28],
	creeper    = [24, 34],
	skeleton   = [24, 34],
	spider     = [20, 30],
	zombie     = [22, 34],
	guardian   = [26, 36],
	blaze      = [16, 26],
	enderman   = [24, 34],
	witch      = [28, 36],
	villager   = [28, 36],
	item       = [10, 18],
	falling    = [16, 28],
	bat        = [12, 18],
	bat        = [12, 22],
	minecart   = [24, 28],
	rabbit     = [16, 32],
	armor_st   = [16, 24],
	iron_golem = [22, 38],

	//По умолчанию берутся значения из animals
	pig        = [18, 38]
	sheep      = [18, 38]
	ocelot     = [18, 38]
	horse      = [18, 38]

	//Разное
	spider.rider_spawn   = 80,
	enderman.chance_take = 2000
}