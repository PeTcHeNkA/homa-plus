<fw:AcrylicWindow x:Name="window" x:Class="GF2_LaunchHX.CDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GF2_LaunchHX"
        xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
        mc:Ignorable="d"
                  
        ResizeMode="NoResize"
        ShowInTaskbar="False"
               
        Height="200" Width="300" 
                  
        AcrylicWindowStyle="Normal"
        fw:AcrylicWindow.AcrylicAccentState="BlurBehind"       
        TintOpacity="0.5" NoiseOpacity="0"
                  
        TintColor="{StaticResource ArcMain}"
        FallbackColor="{StaticResource ArcMain}"
                  
        Title="Подтвердить" BorderBrush="{StaticResource ArcHeaderDark}" Foreground="{StaticResource ArcHeaderDark}"
    >
    <Grid>

            <Grid Background="{StaticResource ArcHeader}" Height="30" VerticalAlignment="Top"
                  Panel.ZIndex="1000"
                  >
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
   Foreground="{StaticResource ArcHeaderDark}" Text="{Binding Title, ElementName=window}">
                </TextBlock>
            </Grid>



        <Grid x:Name="DiscriptionCTN" Visibility="Hidden" Background="{StaticResource ArcHeader}" Margin="0,40,0,77"
                  Panel.ZIndex="1000"
              
                  >
            <TextBlock x:Name="DiscriptionVB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" TextAlignment="Center" TextWrapping="WrapWithOverflow"
Foreground="{StaticResource ArcSecondText}">
                </TextBlock>
            </Grid>


        <Grid Margin="0,0,0,55">
            <Grid>
                <Grid.OpacityMask>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" >
                        <GradientStop Color="Black" Offset="0.85"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.OpacityMask>

                <Image x:Name="BgImg" Stretch="UniformToFill" Visibility="Collapsed"/>
            </Grid>
            <Grid.OpacityMask>
                <LinearGradientBrush EndPoint="0.35,1" StartPoint="0.2,0" >
                    <GradientStop Color="Black" Offset="0.33"/>
                    <GradientStop Color="Transparent" Offset="0"/>
                </LinearGradientBrush>
            </Grid.OpacityMask>
        </Grid>

        <Button x:Name="BtnNo" Margin="10,0,0,21" Height="45" 
        VerticalAlignment="Bottom" FontFamily="Microsoft YaHei" FontSize="24"
        HorizontalAlignment="Left" Width="134"
                Click="BtnNo_Click"
        >
            <Path Height="30" Width="30" Fill="{Binding Foreground, ElementName=BtnNo}" Stretch="Fill" Data="M256-213.85 213.85-256l224-224-224-224L256-746.15l224 224 224-224L746.15-704l-224 224 224 224L704-213.85l-224-224-224 224Z"/>
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ArcBotton}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ArcRedHover}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Button x:Name="BtnYes" Margin="0,0,10,21" Height="45" 
VerticalAlignment="Bottom" FontFamily="Microsoft YaHei" FontSize="24"
HorizontalAlignment="Right" Width="134"
                Click="BtnYes_Click"
>
            <Path Height="30" Width="40" Fill="{Binding Foreground, ElementName=BtnYes}" Stretch="Fill" Data="M389-280.85 209.62-459.23 246.38-497 389-354.38 713.62-678l36.76 36.77L389-280.85Z"/>
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ArcBotton}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ArcGreenHover}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Button x:Name="BtnOk" Margin="10,0,10,21" Height="45" 
VerticalAlignment="Bottom" FontFamily="Microsoft YaHei" FontSize="24"
HorizontalAlignment="Center" Width="280" Visibility="Hidden"
                Click="BtnYes_Click"
>
            <Path Height="30" Width="40" Fill="{Binding Foreground, ElementName=BtnOk}" Stretch="Fill" Data="M389-280.85 209.62-459.23 246.38-497 389-354.38 713.62-678l36.76 36.77L389-280.85Z"/>
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ArcBotton}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ArcGreenHover}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

    </Grid>
</fw:AcrylicWindow>