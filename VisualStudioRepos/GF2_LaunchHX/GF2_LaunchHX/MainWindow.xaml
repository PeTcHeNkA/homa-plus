<fw:AcrylicWindow x:Name="window" x:Class="GF2_LaunchHX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
        xmlns:local="clr-namespace:GF2_LaunchHX"
        mc:Ignorable="d"  
                  
        Height="350" Width="670" MinHeight="300" MinWidth="670"
                  

        AcrylicWindowStyle="NoIcon"
        fw:AcrylicWindow.AcrylicAccentState="BlurBehind"       
        TintOpacity="0.5" NoiseOpacity="0"
                  
        TintColor="{StaticResource ArcMain}"
        FallbackColor="{StaticResource ArcMain}"
                  
        Title="GF2_LaunchHX" BorderBrush="{StaticResource ArcHeaderDark}" Foreground="{StaticResource ArcHeaderDark}"
    >

