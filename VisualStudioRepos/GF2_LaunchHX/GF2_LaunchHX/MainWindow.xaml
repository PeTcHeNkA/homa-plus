        </Button>

        <!-- Content here -->
        <Button x:Name="BTNDiscord" Visibility="Hidden"/>
        <Button x:Name="BTNPlay" Margin="0,0,10,21" Height="45" Click="BTNPlay_Click"
                VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="230" 
                FontFamily="Microsoft YaHei" FontSize="24">
            <Grid>
                <TextBlock x:Name="BTNPlayT" Foreground="{Binding Foreground, ElementName=BTNPlay}" TextAlignment="Center" FontSize="30" Text="Играть" VerticalAlignment="Top"/>
            </Grid>
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ArcBotton}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#CC7AFF4C"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

