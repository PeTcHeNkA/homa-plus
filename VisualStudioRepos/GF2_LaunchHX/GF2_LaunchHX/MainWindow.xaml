                       TextAlignment="Center" FontSize="30" Text="Установить" VerticalAlignment="Top"/>
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ArcBotton}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#CCFFD16C"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

