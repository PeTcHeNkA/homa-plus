<fw:AcrylicWindow x:Class="GF2_RU_Launch.Editor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GF2_RU_Launch"
        xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF" xmlns:col="clr-namespace:System.Collections;assembly=mscorlib"
                  mc:Ignorable="d"
        Title="Girls Frontline 2: Exilium RU Launcher | Changelog" Height="350" Width="650" MinHeight="300" MinWidth="610"
        TintColor="#90FFFFFF" TintOpacity="0.5"
        FallbackColor="#90FFFFFF"
        AcrylicWindowStyle="NoIcon"
        fw:AcrylicWindow.AcrylicAccentState="BlurBehind" Background="#26FFFFFF" FontFamily="Arial" RenderTransformOrigin="0.5,0.5">

    <fw:AcrylicWindow.BorderBrush>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF515254" Offset="0.01"/>
            <GradientStop Color="#FFC5DCE4" Offset="1"/>
        </LinearGradientBrush>
    </fw:AcrylicWindow.BorderBrush>
    <fw:AcrylicWindow.RenderTransform>
        <TransformGroup>
            <ScaleTransform/>
            <SkewTransform/>
            <RotateTransform/>
            <TranslateTransform X="0"/>
        </TransformGroup>
    </fw:AcrylicWindow.RenderTransform>

    <Grid>

        <Menu x:Name="MENU" Height="18" VerticalAlignment="Top" Margin="0,30,0,0" Background="#7FF0F0F0">
            <MenuItem Header="Файл" >
                <MenuItem Header="Импорт">
                    <MenuItem Header="Шаблон .bytes" Click="onClickLoad"></MenuItem>
                    <MenuItem Header="Релиз .bytes" Click="onClickLoadSecond"></MenuItem>
                    <MenuItem Header="Карта переводов .json" Click="onClickLoadLang"></MenuItem>
                    <MenuItem Header="Установленный пакет локализации" Click="onClickLoadActivePack"></MenuItem>
                    <MenuItem Header="Правила сортировки .json" Foreground="#FFFF6666" ></MenuItem>

                </MenuItem>
                <MenuItem Header="Экспорт" >
                    <MenuItem Header="Релиз .bytes"></MenuItem>
                    <MenuItem Header="Карта переводов .json" Click="onClickExportLangJson"></MenuItem>
                    <MenuItem Header="Карта переводов c ID .json" Click="onClickExportLangJsonID"></MenuItem>
                </MenuItem>
                <MenuItem Header="Закрыть таблицу" Click="onClickClose"></MenuItem>
            </MenuItem>
            <MenuItem Header="Фильтр">
                <MenuItem Header="По ключам" Click="clickKeyFilter"></MenuItem>
                <MenuItem Header="По значениям" Click="clickValueFilter"></MenuItem>
                <MenuItem Header="Пустые" >
                    <MenuItem Header="Показать" Click="onClickShowEmpty" Foreground="#FF91D64E"></MenuItem>
                    <MenuItem Header="Скрыть" Click="onClickHideEmpty" Foreground="#FFFF6666"></MenuItem>
                </MenuItem>
                <MenuItem Header="Слияние по значению">
                    <MenuItem Header="Включить" Click="onClickEnableMerge" Foreground="#FF91D64E"></MenuItem>
                    <MenuItem Header="Выключить" Click="onClickDisableMerge" Foreground="#FFFF6666"></MenuItem>
                </MenuItem>
                <MenuItem Header="Сбросить" Click="clickResetFilter"></MenuItem>
            </MenuItem>
            <MenuItem Header="Сортировка">
                <MenuItem Header="По длине" Foreground="#FFFF6666"></MenuItem>
                <MenuItem Header="По правилам" Foreground="#FFFF6666"></MenuItem>
            </MenuItem>
        </Menu>

        <DataGrid x:Name="TTable" AutoGenerateColumns="False" IsEnabled="True" Margin="0,48,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" CanUserResize="True" IsReadOnly="True"/>
                <DataGridTextColumn Header="Оригинал" Binding="{Binding Original}" Width="290" CanUserResize="True" />
                <DataGridTextColumn Header="Перевод" Binding="{Binding Value}" Width="300" CanUserResize="True" />
            </DataGrid.Columns>


        </DataGrid>

    </Grid>

</fw:AcrylicWindow>