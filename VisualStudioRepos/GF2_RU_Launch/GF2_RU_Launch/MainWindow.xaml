<fw:AcrylicWindow x:Class="GF2_RU_Launch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GF2_RU_Launch"
        xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
        mc:Ignorable="d"
        Title="Girls Frontline 2: Exilium RU Launcher" Height="350" Width="650" MinHeight="300" MinWidth="610"
        TintColor="#90FFFFFF" TintOpacity="0.5"
        FallbackColor="#90FFFFFF"
        AcrylicWindowStyle="NoIcon"
        fw:AcrylicWindow.AcrylicAccentState="BlurBehind" Background="#26FFFFFF" FontFamily="Arial" RenderTransformOrigin="0.5,0.5">
    <fw:AcrylicWindow.BorderBrush>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF515254" Offset="0.01"/>
            <GradientStop Color="#FFC5DCE4" Offset="1"/>
        </LinearGradientBrush>
    </fw:AcrylicWindow.BorderBrush>
    <fw:AcrylicWindow.RenderTransform>
        <TransformGroup>
            <ScaleTransform/>
            <SkewTransform/>
            <RotateTransform/>
            <TranslateTransform X="0"/>
        </TransformGroup>
    </fw:AcrylicWindow.RenderTransform>


    <Grid x:Name="Layer1">
        <Image x:Name="BGImg" Source="/images/groza1.png" Margin="0,0,0,75" VerticalAlignment="Top" Stretch="UniformToFill">

        </Image>

        <Button x:Name="BTnPlay" Margin="0,0,10,21" Height="44" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="230" FontFamily="Microsoft YaHei" FontSize="24" Background="#4C6F6F6F">
            <Button.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#00F1F1F1"/>
                    <GradientStop Color="#7F383838" Offset="1"/>
                </LinearGradientBrush>
            </Button.BorderBrush> Start
        </Button>
        <Button x:Name="BTnPlayInstall" Margin="70,0,240,21" Height="44" VerticalAlignment="Bottom" FontFamily="Microsoft YaHei" FontSize="24" Background="#4C6F6F6F" Content="">
            <Button.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#00F1F1F1"/>
                    <GradientStop Color="#7F383838" Offset="1"/>
                </LinearGradientBrush>
            </Button.BorderBrush>
        </Button>
        <Button x:Name="BTnnUninstall" Margin="10,0,0,21" Height="44" VerticalAlignment="Bottom" FontFamily="Microsoft YaHei" FontSize="24" Background="#4C6F6F6F" Content="" AutomationProperties.Name="Uninstall" HorizontalAlignment="Left" Width="45">
            <Button.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#00F1F1F1"/>
                    <GradientStop Color="#7F383838" Offset="1"/>
                </LinearGradientBrush>
            </Button.BorderBrush>
        </Button>
    </Grid>

</fw:AcrylicWindow>
