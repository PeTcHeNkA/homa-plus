<fw:AcrylicWindow x:Class="GF2_RU_Launch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GF2_RU_Launch"
        xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
        mc:Ignorable="d"
        Title="Girls Frontline 2: Exilium RU Launcher" Height="350" Width="650" MinHeight="300" MinWidth="610"
        TintColor="#90FFFFFF" TintOpacity="0.5"
        FallbackColor="#90FFFFFF"
        AcrylicWindowStyle="NoIcon"
        fw:AcrylicWindow.AcrylicAccentState="BlurBehind" Background="#26FFFFFF" FontFamily="Arial" RenderTransformOrigin="0.5,0.5">
    <fw:AcrylicWindow.BorderBrush>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF515254" Offset="0.01"/>
            <GradientStop Color="#FFC5DCE4" Offset="1"/>
        </LinearGradientBrush>
    </fw:AcrylicWindow.BorderBrush>
    <fw:AcrylicWindow.RenderTransform>
        <TransformGroup>
            <ScaleTransform/>
            <SkewTransform/>
            <RotateTransform/>
            <TranslateTransform X="0"/>
        </TransformGroup>
    </fw:AcrylicWindow.RenderTransform>


    <Grid x:Name="Layer1">
        <!-- Header -->

        <Grid Background="#7FECECEC" Panel.ZIndex="1000" Height="30" VerticalAlignment="Top">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-67,0,0,0" Width="249" FontSize="14">Girls Frontline 2: Exilium RU Launcher</TextBlock>
        </Grid>


        <!-- Background -->
        <Border BorderThickness="0,0,0,3" VerticalAlignment="Top" Margin="0,0,0,75">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0.5,0.995" EndPoint="0.5,1" >
                    <GradientStop Color="#7F383838"/>
                    <GradientStop Color="#00F1F1F1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Image x:Name="BGImg" Source="/images/groza1.png" 
               VerticalAlignment="Center" Stretch="UniformToFill"/>
        </Border>

        <!-- Open Editor -->
        <Button x:Name="BTNEditor" Width="95" Height="95" Margin="0,30,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}" >
                                <Border 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="0"
                            >
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0,0.5">
                                <GradientStop Color="#7FECECEC"/>
                                <GradientStop Color="Transparent" Offset="0.35"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0,0.5">
                                        <GradientStop Color="#BFD8D8D8"/>
                                        <GradientStop Color="Transparent" Offset="0.6"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Grid Width="95" Height="95">
                <Image Height="30" Width="30" VerticalAlignment="Top" HorizontalAlignment="Left" Source="/Images/edit_ico.png" Margin="8,8,0,0" />
            </Grid>
        </Button>


        <!-- Play bottons start -->
        <Button x:Name="BTnPlay" Margin="0,0,10,21" Height="44" 
                VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="230" 
                FontFamily="Microsoft YaHei" FontSize="24">

            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}" >
                                <Border 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="{TemplateBinding Padding}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    >
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                    <Setter Property="Background" Value="#4C6F6F6F"/>

                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#00F1F1F1"/>
                                <GradientStop Color="#7F383838" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF7AFF4C"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            Start
        </Button>
        <Button x:Name="BTnPlayInstall" Margin="55,0,240,21" Height="44" 
                VerticalAlignment="Bottom" FontFamily="Microsoft YaHei" FontSize="24" 
                Content="">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}" >
                                <Border 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="{TemplateBinding Padding}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    >
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                    <Setter Property="Background" Value="#4C6F6F6F"/>

                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#00F1F1F1"/>
                                <GradientStop Color="#7F383838" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFFFC84F"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button x:Name="BTnnUninstall" Margin="10,0,0,21" Height="45" 
                VerticalAlignment="Bottom" FontFamily="Microsoft YaHei" 
                FontSize="24"
                AutomationProperties.Name="Uninstall" HorizontalAlignment="Left" Width="45"
                >
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}" >
                                <Border 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="{TemplateBinding Padding}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    >
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                    <Setter Property="Background" Value="#4C6F6F6F"/>

                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#00F1F1F1"/>
                                <GradientStop Color="#7F383838" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E5FF2C2C"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>

            <Image Source="/Images/delete_ico.png" 
                   Stretch="UniformToFill" Width="25" Height="25"/>

        </Button>
        <!-- Play bottons end   -->
    </Grid>

</fw:AcrylicWindow>
