<fw:AcrylicWindow x:Class="GF2_RU_Launch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GF2_RU_Launch"
        xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
                  
        xmlns:svg="http://sharpvectors.codeplex.com/runtime/"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"

        mc:Ignorable="d"
        Title="Girls Frontline 2: Exilium RU Launcher" Height="350" Width="650" MinHeight="300" MinWidth="610"
        
        TintColor="{DynamicResource L_Background_Main_Color}" 
        FallbackColor="{DynamicResource L_Background_Main_Color}"
    
        NoiseOpacity="0" 
        TintOpacity="0.65"
                  
        AcrylicWindowStyle="NoIcon"
        fw:AcrylicWindow.AcrylicAccentState="BlurBehind" Background="{StaticResource L_Background_Second}" 
        FontFamily="Arial" RenderTransformOrigin="0.5,0.5" BorderBrush="{StaticResource L_Border}">
    <Grid>
        <!-- Header -->

        <Grid Background="{StaticResource Header}" Panel.ZIndex="1000" Height="30" VerticalAlignment="Top">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-67,0,0,0" Width="249" FontSize="14"
                       Foreground="{StaticResource Header_Text}"
                       >
                Girls Frontline 2: Exilium RU Launcher
            </TextBlock>
        </Grid>

        <TextBlock Opacity="0.5" Text="{x:Static local:MainWindow.LAUNCH_VERSION}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,35,10,0" Panel.ZIndex="1000"/>

        <!-- Background -->
        <Border BorderThickness="0,0,0,3" VerticalAlignment="Top" Margin="0,0,0,75" BorderBrush="{StaticResource Background}">
            <Image x:Name="BGImg" Source="/images/groza1.png" 
               VerticalAlignment="Center" Stretch="UniformToFill"/>
        </Border>


        <!-- Open Editor -->
        <Grid x:Name="BGBtns" Width="165" Height="114" Opacity="0.55"
                Margin="0,30,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
              MouseEnter="OnEnterBtnsBg" MouseLeave="OnLeaveBtnsBg"
              >
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.2,0.85" StartPoint="0,0.45">
                    <GradientStop Color="{DynamicResource Header_Color}"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid x:Name="BTNSettings" Width="45" Height="45" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Image Height="30" Width="30" 
                        Source="/Images/settings_ico.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <Grid x:Name="BTNEditor" Width="45" Height="45" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="45,0,0,0" >
                <Image Height="30" Width="30" 
                        Source="/Images/edit_ico.png" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

        </Grid>



        <!-- Play bottons start -->
        <Button x:Name="BTnPlay" Click ="OnClickPlay" Margin="0,0,10,21" Height="44" 
                VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="230" 
                FontFamily="Microsoft YaHei" FontSize="24">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource LBottons}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BtnPlay_Hover}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            Start
        </Button>
        <!-- Центральная кнопка -->
        <Button x:Name="BTnPlayInstall" Click="onInstallClickProxy" Margin="55,0,240,21" Height="44" 
                VerticalAlignment="Bottom" FontFamily="Microsoft YaHei" FontSize="24">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource LBottons}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BtnInst_Hover}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            Test..Text
        </Button>
        <!--Кнопка удалить-->
        <Button x:Name="BTnnUninstall" Click="onUnInstallClick"  Margin="10,0,0,21" Height="45" 
                VerticalAlignment="Bottom" FontFamily="Microsoft YaHei" 
                FontSize="24"
                AutomationProperties.Name="Uninstall" HorizontalAlignment="Left" Width="45"
                >
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource LBottons}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BtnDel_Hover}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>

            <Image Source="/Images/delete_ico.png" 
                   Stretch="UniformToFill" Width="25" Height="25"/>

        </Button>
        <!-- Play bottons end   -->
    </Grid>

</fw:AcrylicWindow>
