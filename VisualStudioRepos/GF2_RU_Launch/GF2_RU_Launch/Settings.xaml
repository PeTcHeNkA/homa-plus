<fw:AcrylicWindow x:Class="GF2_RU_Launch.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GF2_RU_Launch"
        xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
        mc:Ignorable="d"
        Title="Girls Frontline 2: Exilium RU Launcher | Changelog" Height="350" Width="650" MinHeight="300" MinWidth="610"
        
        TintColor="{DynamicResource L_Background_Main_Color}" 
        FallbackColor="{DynamicResource L_Background_Main_Color}"
    
        NoiseOpacity="0" 
        TintOpacity="0.65"   
                  
        AcrylicWindowStyle="NoIcon"
        fw:AcrylicWindow.AcrylicAccentState="BlurBehind" Background="#26FFFFFF" FontFamily="Arial" RenderTransformOrigin="0.5,0.5">
    <fw:AcrylicWindow.BorderBrush>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF515254" Offset="0.01"/>
            <GradientStop Color="#FFC5DCE4" Offset="1"/>
        </LinearGradientBrush>
    </fw:AcrylicWindow.BorderBrush>

    <Grid>
        <Grid VerticalAlignment="Top" Height="44">
            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <Border VerticalAlignment="Top" Height="44"
                    BorderThickness="1,1,1,1"
                Background="{DynamicResource Bottons_Background}"
                BorderBrush="{DynamicResource Bottons_Border}" HorizontalAlignment="Left" Width="370" Grid.RowSpan="2"
                >
                <Grid Margin="0,0,0,0">
                    <TextBlock x:Name="ChangeLHead" 
                   VerticalAlignment="Center"
                   TextAlignment="Left"
                   FontFamily="Microsoft YaHei" FontSize="24" 
                   Text="Пакеты локализации" Margin="25,0,0,0" Height="32" 
                   />
                </Grid>
            </Border>

            <Button x:Name="ResetPacks" Height="44" 
                    VerticalAlignment="Top" FontFamily="Microsoft YaHei" 
                    FontSize="24" Margin="370,0,25,0" Grid.RowSpan="2"
                    >
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource LBottons}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BtnDel_Hover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                Сбросить
            </Button>

            <Border Width="25"
                    HorizontalAlignment="Right"
                    BorderThickness="1,1,1,1"
                Background="{DynamicResource Bottons_Background}"
                BorderBrush="{DynamicResource Bottons_Border}" Grid.RowSpan="2"
                />
        </Grid>

        <DataGrid x:Name="Packs" IsEnabled="True" Margin="0,44,0,0" AutoGenerateColumns="False"
                  Background="{DynamicResource Header}" CanUserAddRows="True" CanUserDeleteRows="True" Height="92" VerticalAlignment="Top"
        >
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="TT_ID" Header="Приоретет" Binding="{Binding Priority}" Width="70" CanUserResize="True"/>
                <DataGridTextColumn x:Name="TT_ORG" Header="Название" Binding="{Binding Name}" Width="100" CanUserResize="True" />
                <DataGridTextColumn x:Name="TT_RES" Header="Расположение" Binding="{Binding Source}" Width="450" CanUserResize="True" />
            </DataGrid.Columns>

        </DataGrid>

        <Border VerticalAlignment="Top" Height="44" BorderThickness="0,1,0,1" Margin="0,136,0,0"
                Background="{DynamicResource Bottons_Background}"
                BorderBrush="{DynamicResource Bottons_Border}"
                >

            <Grid>
                <TextBlock x:Name="ChangeLHead1" 
                    VerticalAlignment="Center"
                    TextAlignment="Left"
                    FontFamily="Microsoft YaHei" FontSize="24" 
                    Margin="25,0,325,0" Height="32" 
                   >До-перевод</TextBlock>
                <ComboBox x:Name="CHSTranslateMode" VerticalAlignment="Center" Height="32" Margin="440,0,25,0">
                    <ComboBoxItem Tag="1" IsSelected="True">
                        <TextBlock Height="26" FontSize="24" Background="Aqua" Text="Отключено"/>
                    </ComboBoxItem>
                </ComboBox>
            </Grid>
        </Border>



    </Grid>
</fw:AcrylicWindow>