<fw:AcrylicWindow x:Class="GF2_RU_Launch.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GF2_RU_Launch"
        xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
                  
                  xmlns:col="clr-namespace:System.Collections;assembly=mscorlib"
                  
        mc:Ignorable="d"
        Title="Girls Frontline 2: Exilium RU Launcher | Settings" Height="400" Width="650" MinHeight="388" MinWidth="625"
        
        TintColor="{DynamicResource L_Background_Main_Color}" 
        FallbackColor="{DynamicResource L_Background_Main_Color}"
    
        NoiseOpacity="0" 
        TintOpacity="0.65"   
                  
        AcrylicWindowStyle="NoIcon"
        fw:AcrylicWindow.AcrylicAccentState="BlurBehind" Background="#26FFFFFF" FontFamily="Arial" RenderTransformOrigin="0.5,0.5">
    <fw:AcrylicWindow.BorderBrush>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF515254" Offset="0.01"/>
            <GradientStop Color="#FFC5DCE4" Offset="1"/>
        </LinearGradientBrush>
    </fw:AcrylicWindow.BorderBrush>

    <Window.Resources>
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" 
                        Grid.ColumnSpan="2"
                        CornerRadius="0"
                        Background="{DynamicResource Bottons_Background}"
                        BorderBrush="{DynamicResource Bottons_Border}"
                        BorderThickness="1" />
                <Path x:Name="Arrow"
                      Grid.Column="1"     
                      Fill="Black"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M0,0 L0,2 L4,6 L8,2 L8,0 L4,4 z"
                    />
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="ComboBoxTextBox" TargetType="{x:Type TextBox}">
            <Border x:Name="PART_ContentHost" Focusable="False" Background="{TemplateBinding Background}" />
        </ControlTemplate>

        <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton 
                                Name="ToggleButton" 
                                Template="{StaticResource ComboBoxToggleButton}" 
                                Grid.Column="2" 
                                Focusable="false"
                                IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press">
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"  Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                Margin="3,3,23,3"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center" />
                            <TextBox x:Name="PART_EditableTextBox"
                                Style="{x:Null}" 
                                Template="{StaticResource ComboBoxTextBox}" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                Margin="3,3,23,3"
                                Focusable="True" 
                                Background="{DynamicResource Bottons_Background}"
                                Foreground="Green"
                                Visibility="Hidden"
                                IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup 
                                Name="Popup"
                                Placement="Bottom"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True" 
                                Focusable="False"
                                PopupAnimation="Slide">

                                <Grid Name="DropDown"
                                  SnapsToDevicePixels="True"                
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border 
                                    x:Name="DropDownBorder"
                                    Background="{DynamicResource Bottons_Background2}"
                                     
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Bottons_Border}"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="true">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                            </Trigger>
                            <Trigger SourceName="Popup" Property="Popup.AllowsTransparency" Value="true">
                                <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="0"/>
                                <Setter TargetName="DropDownBorder" Property="Margin" Value="0,2,0,0"/>
                            </Trigger>
                            <Trigger Property="IsEditable"  Value="true">
                                <Setter Property="IsTabStop" Value="false"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Установленные пакеты (заголовок) -->
        <Grid VerticalAlignment="Top" Height="44">
            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <Border VerticalAlignment="Top" Height="44"
                    BorderThickness="1,1,1,1"
                Background="{DynamicResource Bottons_Background}"
                BorderBrush="{DynamicResource Bottons_Border}" HorizontalAlignment="Left" Width="370" Grid.RowSpan="2"
                >
                <Grid Margin="0,0,0,0">
                    <TextBlock
                   VerticalAlignment="Center"
                   TextAlignment="Left"
                   FontFamily="Microsoft YaHei" FontSize="22" 
                   Text="Пакеты локализации" Margin="25,0,0,0" Height="32" 
                   />
                </Grid>
            </Border>

            <Button x:Name="ResetPacks" Height="44" 
                    VerticalAlignment="Top" FontFamily="Microsoft YaHei" 
                    FontSize="22" Margin="370,0,25,0" Grid.RowSpan="2" Click="ResetPacks_Click"
                    >
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource LBottons}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BtnDel_Hover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                Сбросить
            </Button>

            <Border Width="25"
                    HorizontalAlignment="Right"
                    BorderThickness="1,1,1,1"
                Background="{DynamicResource Bottons_Background}"
                BorderBrush="{DynamicResource Bottons_Border}" Grid.RowSpan="2"
                />
        </Grid>

        <!-- Установленные пакеты (таблица) -->
        <DataGrid x:Name="Packs" IsEnabled="True" Margin="0,44,0,0" AutoGenerateColumns="False"
                  Background="Transparent" BorderBrush="{DynamicResource Bottons_Background}" CanUserAddRows="True" CanUserDeleteRows="True" Height="92" VerticalAlignment="Top"
        >
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource Bottons_Background}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Bottons_Border}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowHeaderStyle>
                <Style TargetType="DataGridRowHeader">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </DataGrid.RowHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn x:Name="TT_ID" Binding="{Binding Priority}" Width="75" CanUserResize="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Margin="5,0,0,0" HorizontalAlignment="Center" Text="Приоретет"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="TT_ORG" Binding="{Binding Name}" Width="95" CanUserResize="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Margin="5,0,0,0" HorizontalAlignment="Center" Text="Название"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="TT_RES" Binding="{Binding Source}" Width="450" CanUserResize="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Margin="5,0,0,0" HorizontalAlignment="Center" Text="Расположение"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>

        </DataGrid>

        <!-- До-перевод -->
        <Grid VerticalAlignment="Top" Height="44" Margin="0,136,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <Border VerticalAlignment="Top" Height="44"
                    BorderThickness="1,1,1,1"
                Background="{DynamicResource Bottons_Background}"
                BorderBrush="{DynamicResource Bottons_Border}" HorizontalAlignment="Left" Width="370" Grid.RowSpan="2"
                >
                <Grid Margin="0,0,0,0">
                    <TextBlock
                   VerticalAlignment="Center"
                   TextAlignment="Left"
                   FontFamily="Microsoft YaHei" FontSize="22" 
                   Text="До-перевод" Margin="25,0,0,0" Height="32" 
                   />
                </Grid>
            </Border>

            <ComboBox x:Name="CHSTranslateMode" VerticalAlignment="Top" Height="44" Margin="370,0,25,0" Grid.RowSpan="2"
                      Background="{DynamicResource Bottons_Background}"
                      BorderBrush="{DynamicResource Bottons_Border}"
                      BorderThickness="1,1,1,1"
                      >
                <ComboBoxItem Tag="1" IsSelected="True">
                    <TextBlock Height="26" FontSize="22" Text="Отключено"/>
                </ComboBoxItem>

                <ComboBoxItem Tag="2">
                    <TextBlock Height="26" FontSize="22" Text="Скоро ..."/>
                </ComboBoxItem>
            </ComboBox>

            <Border Width="25"
                    HorizontalAlignment="Right"
                    BorderThickness="1,1,1,1"
                Background="{DynamicResource Bottons_Background}"
                BorderBrush="{DynamicResource Bottons_Border}" Grid.RowSpan="2"
                />
        </Grid>

        <!-- Ветка лаунчера -->
        <Grid VerticalAlignment="Bottom" Height="44" Margin="0,0,0,44">
            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <Border VerticalAlignment="Top" Height="44"
                BorderThickness="1,1,1,1"
            Background="{DynamicResource Bottons_Background}"
            BorderBrush="{DynamicResource Bottons_Border}" HorizontalAlignment="Left" Width="370" Grid.RowSpan="2"
            >
                <Grid Margin="0,0,0,0">
                    <TextBlock
               VerticalAlignment="Center"
               TextAlignment="Left"
               FontFamily="Microsoft YaHei" FontSize="22" 
               Text="Ветка" Margin="25,0,0,0" Height="32" 
               />
                </Grid>
            </Border>

            <Border VerticalAlignment="Top" Height="44" Margin="370,0,25,0"
                Grid.RowSpan="2"
    BorderThickness="1,1,1,1"
Background="{DynamicResource Bottons_Background}"
BorderBrush="{DynamicResource Bottons_Border}"
>
                <TextBlock
   VerticalAlignment="Center"
   TextAlignment="Center"
   FontFamily="Microsoft YaHei" FontSize="22" 
   Text="{x:Static local:Settings.UN_BRANCH}" Height="32" 
   />
            </Border>

            <Border Width="25"
                HorizontalAlignment="Right"
                BorderThickness="1,1,1,1"
            Background="{DynamicResource Bottons_Background}"
            BorderBrush="{DynamicResource Bottons_Border}" Grid.RowSpan="2"
            />
        </Grid>

        <!-- Версия лаунчера -->
        <Grid VerticalAlignment="Bottom" Height="44" Margin="0,0,0,88">
            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <Border VerticalAlignment="Top" Height="44"
                    BorderThickness="1,1,1,1"
                Background="{DynamicResource Bottons_Background}"
                BorderBrush="{DynamicResource Bottons_Border}" HorizontalAlignment="Left" Width="370" Grid.RowSpan="2"
                >
                <Grid Margin="0,0,0,0">
                    <TextBlock
                   VerticalAlignment="Center"
                   TextAlignment="Left"
                   FontFamily="Microsoft YaHei" FontSize="22" 
                   Text="Версия лаунчера" Margin="25,0,0,0" Height="32" 
                   />
                </Grid>
            </Border>

            <Border VerticalAlignment="Top" Height="44" Margin="370,0,25,0"
                    Grid.RowSpan="2"
        BorderThickness="1,1,1,1"
    Background="{DynamicResource Bottons_Background}"
    BorderBrush="{DynamicResource Bottons_Border}"
    >
                <TextBlock
       VerticalAlignment="Center"
       TextAlignment="Center"
       FontFamily="Microsoft YaHei" FontSize="22" 
       Text="{x:Static local:MainWindow.LAUNCH_VERSION}" Height="32" 
       />
            </Border>

            <Border Width="25"
                    HorizontalAlignment="Right"
                    BorderThickness="1,1,1,1"
                Background="{DynamicResource Bottons_Background}"
                BorderBrush="{DynamicResource Bottons_Border}" Grid.RowSpan="2"
                />
        </Grid>

        <!-- Discord RPC -->
        <Grid VerticalAlignment="Top" Height="44" Margin="0,180,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <Border VerticalAlignment="Top" Height="44"
                BorderThickness="1,1,1,1"
                Background="{DynamicResource Bottons_Background}"
                BorderBrush="{DynamicResource Bottons_Border}" HorizontalAlignment="Left" Width="370" Grid.RowSpan="2"
                >
                <Grid Margin="0,0,0,0">
                    <TextBlock
                        VerticalAlignment="Center"
                        TextAlignment="Left"
                        FontFamily="Microsoft YaHei" FontSize="22" 
                        Text="Discord RPC" Margin="25,0,0,0" Height="32" 
                   />
                </Grid>
            </Border>

            <ComboBox x:Name="CHSDiscordRPC" VerticalAlignment="Top" Height="44" Margin="370,0,25,0" Grid.RowSpan="2"
                Background="{DynamicResource Bottons_Background}"
                BorderBrush="{DynamicResource Bottons_Border}"
                BorderThickness="1,1,1,1" SelectionChanged="CHSDiscordRPC_SelectionChanged"
                      >
                <ComboBoxItem x:Uid="dsc1en" IsSelected="True">
                    <TextBlock Height="26" FontSize="22" Text="Отключено"/>
                </ComboBoxItem>

                <ComboBoxItem Uid="dsc1dis" Tag="2">
                    <TextBlock Height="26" FontSize="22" Text="Включено"/>
                </ComboBoxItem>
            </ComboBox>

            <Border Width="25"
                HorizontalAlignment="Right"
                BorderThickness="1,1,1,1"
                Background="{DynamicResource Bottons_Background}"
                BorderBrush="{DynamicResource Bottons_Border}" Grid.RowSpan="2"
                />
        </Grid>

        <!-- Сохранить изменения -->
        <Grid VerticalAlignment="Bottom" Height="44" Margin="0,0,0,00">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32*"/>
                <ColumnDefinition Width="33*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>

            <Button Height="44" 
                VerticalAlignment="Top" FontFamily="Microsoft YaHei" 
                FontSize="22" Margin="55,0,0,0" Grid.RowSpan="2"
                Content="Сбросить" Click="ResetSettinsClick"
                    >
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource LBottons}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BtnDel_Hover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Height="44" 
                VerticalAlignment="Top" FontFamily="Microsoft YaHei" 
                FontSize="22" Margin="0,0,55,0" Grid.RowSpan="2"
                Content="Сохранить изменения" Grid.Column="1" Click="SaveSettinsClick"
                    >
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource LBottons}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BtnPlay_Hover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Border Width="55"
                HorizontalAlignment="Right"
                BorderThickness="1,1,1,1"
                Background="{DynamicResource Bottons_Background}"
                BorderBrush="{DynamicResource Bottons_Border}" Grid.RowSpan="2" Grid.Column="1"
                />
            <Border Width="55"
                HorizontalAlignment="Left"
                BorderThickness="1,1,1,1"
                Background="{DynamicResource Bottons_Background}"
                BorderBrush="{DynamicResource Bottons_Border}" Grid.RowSpan="2"
                />
        </Grid>

    </Grid>
</fw:AcrylicWindow>