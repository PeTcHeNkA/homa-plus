<fw:AcrylicWindow x:Class="$safeprojectname$.ArcChangelogs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:$safeprojectname$"
        xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
        mc:Ignorable="d"
               
        Height="350" Width="650" MinHeight="300" MinWidth="610"
          
        AcrylicWindowStyle="NoIcon"
        fw:AcrylicWindow.AcrylicAccentState="BlurBehind"       
        TintOpacity="0.5" NoiseOpacity="0"
          
        TintColor="{StaticResource ArcMain}"
        FallbackColor="{StaticResource ArcMain}"
                  
        Title="$safeprojectname$ | Changelog"
    >

    <Grid>
        <Grid Background="{StaticResource ArcHeader}" Panel.ZIndex="1000" Height="30" VerticalAlignment="Top">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-67,0,0,0" Width="249" FontSize="14"
                       Foreground="{StaticResource ArcHeaderDark}">
                $safeprojectname$ | Changelog
            </TextBlock>
        </Grid>
        
        <Border Background="#4C6F6F6F" VerticalAlignment="Top" Height="44" BorderThickness="0,1,0,1" Margin="0,30,-10,0">
            <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#00F1F1F1"/>
                    <GradientStop Color="#7F383838" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <TextBlock x:Name="ChangelogHeader" 
               VerticalAlignment="Center"
               TextAlignment="Center"
               FontFamily="Microsoft YaHei" FontSize="24" 
               >
                Список изменений
            </TextBlock>
        </Border>

        <ListView x:Name="ChangelogContent" Background="Transparent" BorderThickness="0"
                 Padding="5" Focusable="False" Margin="0,74,0,10"
                d:ItemsSource="{d:SampleData ItemCount=5}" 
                  >
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</fw:AcrylicWindow>