<fw:AcrylicWindow x:Class="LUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
        xmlns:local="clr-namespace:LUpdater"
        mc:Ignorable="d"
                  
        ShowInTaskbar="False"
        AcrylicWindowStyle="None"
        fw:AcrylicWindow.AcrylicAccentState="BlurBehind"
                  
        Title="MainWindow" 
                  
        Height="320" Width="650"
                  
        TintColor="#5F3A3A3A" TintOpacity="0.5"
        FallbackColor="#5F3A3A3A"
        
        NoiseOpacity="0" ResizeMode="NoResize"
    >
    <Window.Resources>
        <SolidColorBrush x:Key="Header"  Color="#BF2D2D2D"/>
        <SolidColorBrush x:Key="Header_Text"  Color="White"/>
    </Window.Resources>

    <Grid MouseLeftButtonDown="On_DragWindow">
        <Grid x:Name="HEADER" Background="{StaticResource Header}" Panel.ZIndex="1000" Height="30" VerticalAlignment="Top">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                       Foreground="{StaticResource Header_Text}"
                       >
                Girls Frontline 2: Exilium RU Launcher | Updater
            </TextBlock>
        </Grid>

        <Image Source="updater_bg.png" Height="239" VerticalAlignment="Top"/>

        <Border Background="#59FFFFFF" CornerRadius="4" Margin="30,249,30,25">
            <Grid >
                <Border x:Name="PROGRESSBAR" CornerRadius="4" SizeChanged="TrackProgress" Background="#FF5AEC5A" HorizontalAlignment="Left" Width="10"/>

                <TextBlock x:Name="TXT_INF" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center">
                    Подготовка ...
                </TextBlock>

                <Rectangle Stroke="#BF060606" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
            </Grid>
        </Border>

    </Grid>
</fw:AcrylicWindow>
